# API Key (required)
# Get yours from your OpenAI-compatible provider.
OPENAI_API_KEY=sk-xxx

# Model ID (required)
MODEL_ID=gpt-4.1-mini

# Base URL (optional, for OpenAI-compatible providers)
# OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
#  OpenAI-compatible providers
#
#  Provider         MODEL_ID              Base URL
#  ---------------  --------------------  -----------------------------
#  OpenAI           gpt-4.1-mini         (default)
#  DeepSeek         deepseek-chat        https://api.deepseek.com/v1
#  DashScope        qwen-plus            https://dashscope.aliyuncs.com/compatible-mode/v1
#  Moonshot         kimi-k2.5            https://api.moonshot.ai/v1
#  Zhipu            glm-4.5              https://open.bigmodel.cn/api/paas/v4
#
#  Pick any provider that speaks OpenAI's chat-completions protocol.
# =============================================================================
